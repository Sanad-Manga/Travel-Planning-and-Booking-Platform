# Copy to backend/.env and fill in. Never commit real values.
PORT=3001
FRONTEND_URL=http://localhost:3000
MONGODB_URI=<team-mongodb-atlas-connection-string>
JWT_ACCESS_SECRET=<change-me>
JWT_REFRESH_SECRET=<change-me>
# false only for local http dev; when unset it defaults to true if NODE_ENV=production
COOKIE_SECURE=false
HOLD_MINUTES=10
STRIPE_SECRET_KEY=<stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
FX_API_KEY=<fxratesapi-key-if-required>
PLATFORM_CURRENCY=USD

# ACC-18: explicitly provision the administrator with npm run seed:admin.
# Required for that command only; supply your own values locally. Never commit them.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
