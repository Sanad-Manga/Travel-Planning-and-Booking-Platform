# Copy to backend/.env and fill in. Never commit real values.
PORT=3001
FRONTEND_URL=http://localhost:3000
MONGODB_URI=<team-mongodb-atlas-connection-string>
JWT_ACCESS_SECRET=<change-me>
JWT_REFRESH_SECRET=<change-me>
# false only for local http dev; when unset it defaults to true if NODE_ENV=production
COOKIE_SECURE=false
HOLD_MINUTES=10
STRIPE_SECRET_KEY=<stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
FX_API_KEY=<fxratesapi-key-if-required>
PLATFORM_CURRENCY=USD

# GEN-01-B: all optional. Leave unset in development — a throwaway Ethereal test inbox is used
# automatically instead, and its preview URL for each sent email is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ACC-02 (G12): dev/demo only, OFF by default. Only the exact value "true" auto-verifies the email of NEW accounts
# (no verification email is sent). Leave unset or false everywhere else; never use in production.
AUTO_VERIFY_EMAIL=false

# ACC-18: explicitly provision the administrator with npm run seed:admin.
# Required for that command only; supply your own values locally. Never commit them.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
