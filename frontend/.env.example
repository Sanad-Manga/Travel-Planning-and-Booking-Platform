# Where the NestJS API runs. The Next.js server proxies /api/* and /uploads/* to it.
BACKEND_URL=http://localhost:3001

# Stripe PUBLISHABLE test key (pk_test_...), used by the checkout page. Never put a secret key (sk_...) here:
# NEXT_PUBLIC_* values are sent to every browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
